{
  "name": "maintenancerequestapi",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && copyfiles -u 1 \"src/swagger/**/*.yaml\" dist",
    "start": "node dist/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:int": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "migration:up": "npx tsx src/scripts/migrate.ts migration common all up",
    "migration:down": "npx tsx src/scripts/migrate.ts migration common all down",
    "prod:migration:up": "node dist/scripts/migrate.js migration common all up",
    "prod:migration:down": "node dist/scripts/migrate.js migration common all down",
    "test:migration:up": "npx tsx src/scripts/migrate.ts migration test all up",
    "test:migration:down": "npx tsx src/scripts/migrate.ts migration test all down",
    "seeds:up": "npx tsx src/scripts/migrate.ts seed common all up",
    "seeds:down": "npx tsx src/scripts/migrate.ts seed common all down",
    "prod:seeds:up": "node dist/scripts/migrate.js seed common all up",
    "prod:seeds:down": "node dist/scripts/migrate.js seed common all down",
    "test:seeds:up": "npx tsx src/scripts/migrate.ts seed test all up",
    "test:seeds:down": "npx tsx src/scripts/migrate.ts seed test all down"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "bcrypt": "^6.0.0",
    "cls-hooked": "^4.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "faker": "^6.6.6",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cls-hooked": "^4.3.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/pino": "^7.0.4",
    "@types/pino-http": "^5.8.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.10",
    "copyfiles": "^2.4.1",
    "jest": "^30.5.2",
    "jest-fetch-mock": "^4.2.0",
    "set-cookie-parser": "^3.1.2",
    "supertest": "^7.2.2",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
