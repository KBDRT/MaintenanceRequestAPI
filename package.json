{
  "name": "maintenancerequestapi",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "jest --coverage",
    "migration:up": "npx tsx src/scripts/migrate.ts all up",
    "migration:down": "npx tsx src/scripts/migrate.ts all down",
    "migration_prod:up": "node tsx dist/src/scripts/migrate.js all up",
    "migration_prod:down": "node dist/src/scripts/migrate.js all down",
    "seeds:up": "npx tsx src/scripts/seed.ts all up",
    "seeds:down": "npx tsx src/scripts/seed.ts all down",
    "seeds_prod:up": "node tsx dist/src/scripts/seed.js all up",
    "seeds_prod:down": "node dist/src/scripts/seed.js all down"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cls-hooked": "^4.3.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/pino": "^7.0.4",
    "@types/pino-http": "^5.8.4",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "cls-hooked": "^4.2.2",
    "jest": "^30.5.2",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
