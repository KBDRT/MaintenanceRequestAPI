          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": " SELECT \r\n    e.name,\r\n    COUNT(mr.id) as \"Всего заявок\",\r\n    COUNT(CASE WHEN mr.status = 'done' THEN 1 END) as \"Завершенных заявок\"\r\n  FROM \"Equipment\" as e\r\n  LEFT JOIN \"EquipmentPassports\" as ep \r\n    ON e.id = ep.\"equipmentId\"\r\n  LEFT JOIN \"MaintenanceRequests\" as mr \r\n    ON e.id = mr.\"equipmentId\"\r\n  LEFT JOIN \"RequestAssignees\" as ra \r\n    ON ra.\"requestId\" = mr.id\r\n  GROUP BY e.id\r\n  HAVING COUNT(CASE WHEN mr.status = 'done' THEN 1 END) >= 1",
          "refId": "A",
          "sql": {
