          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  ROUND(\r\n    AVG(EXTRACT(EPOCH FROM (rsh.\"createdAt\" - mr.\"plannedAt\")) / 3600.0)::numeric,\r\n    2\r\n  ) AS \"avg hours\",\r\n  s.\"code\"\r\nFROM \"MaintenanceRequests\" mr\r\nJOIN \"Equipment\" e ON e.id = mr.\"equipmentId\"\r\nJOIN \"Sites\" s ON s.id = e.\"siteId\"\r\nJOIN \"RequestStatusHistories\" rsh ON rsh.\"requestId\" = mr.id\r\nWHERE mr.status = 'done'\r\n  AND rsh.\"newStatus\" = 'done'\r\nGROUP BY s.\"code\"\r\nORDER BY 1",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Среднее время закрытие заявок по площадке",
