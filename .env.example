WEATHER_RULE_MAX_PRECIPITATION=2.5
WEATHER_RULE_MAX_TEMPERATURE=10
WEATHER_RULE_MIN_TEMPERATURE=-10

JWT_SECRET_KEY=SECRET_KEY
JWT_MAX_AGE_MS=3600000